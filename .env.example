# Admin credentials for Mission Control
ADMIN_PASSWORD=change-this-password
AUTH_SECRET=generate-a-long-random-secret-here
DASHBOARD_PORT=3000

# Provider selection
DASHBOARD_PROVIDER=hermes
HERMES_MODE=demo

# Hermes paths (used when HERMES_MODE=filesystem)
HERMES_ROOT_DIR=/hermes
HERMES_WORKSPACES_DIR=/hermes/workspaces
HERMES_MAIN_WORKSPACE=/hermes/workspaces/main
HERMES_SESSIONS_DIR=/hermes/sessions
HERMES_SKILLS_DIR=/hermes/skills
HERMES_LOGS_DIR=/hermes/logs
HERMES_AGENT_REGISTRY_PATH=/hermes/agents.json
HERMES_INGEST_TOKEN=change-me
HERMES_HOST_DIR=./data/hermes-demo
HERMES_API_BASE_URL=http://host.docker.internal:8787
HERMES_API_TOKEN=

# OpenClaw compatibility mode (optional)
# OPENCLAW_DIR=/root/.openclaw
# OPENCLAW_WORKSPACE=/root/.openclaw/workspace

# Branding (customize for your instance)
NEXT_PUBLIC_AGENT_NAME=Hermes Mission Control
NEXT_PUBLIC_AGENT_EMOJI=🤖
NEXT_PUBLIC_AGENT_DESCRIPTION=Hermes dashboard and control room
NEXT_PUBLIC_AGENT_LOCATION=
NEXT_PUBLIC_BIRTH_DATE=
NEXT_PUBLIC_AGENT_AVATAR=
NEXT_PUBLIC_OWNER_USERNAME=your-username
NEXT_PUBLIC_OWNER_EMAIL=your-email@example.com
NEXT_PUBLIC_OWNER_COLLAB_EMAIL=collabs@example.com
NEXT_PUBLIC_TWITTER_HANDLE=@username
NEXT_PUBLIC_COMPANY_NAME=HERMES MISSION CONTROL
NEXT_PUBLIC_APP_TITLE=Hermes Mission Control
DEFAULT_MODEL=gpt-5.4
LOCALAI_BASE_URL=http://192.168.1.196:8081
